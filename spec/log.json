{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://m10k.eu/foundry/log.json",
	"title": "Foundry Log Message",
	"type": "object",

	"properties": {
		"message": {
			"description": "Lines in the log message",
			"type": "array",
			"items": {
				"type": "string"
			},
			"minItems": 1
		},

		"level": {
			"description": "Log level of the message",
			"type": "integer"
		},

		"timestamp": {
			"description": "The time when the message was logged",
			"type": "datetime",
		},

		"sender": {
			"description": "Name of the process that sent the message",
			"type": "string"
		},

		"pid": {
			"description": "Process ID of the sender"
			"type": "integer"
		},

		"host": {
			"description": "Name or address of the host running the sender",
			"type": "string"
		},

		"debug": {
			"description": "Filename and line where the message was logged from",
			"type": "string"
		}
	},

	"required": [
		"message",
		"level",
		"timestamp",
		"sender",
		"pid",
		"host"
	]
}
